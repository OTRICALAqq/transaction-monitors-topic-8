<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.0" compressed="false"><diagram id="Виртуальная доска" name="Виртуальная доска Мониторы транзакций"><mxGraphModel dx="1440" dy="1000" grid="0" page="1" pageWidth="1440" pageHeight="1000" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" parent="1" vertex="1" value="Мониторы транзакций" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=40;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="30" y="20" width="1300" height="65" as="geometry"/></mxCell><mxCell id="n2" parent="1" vertex="1" value="Тема 8 • Распределённые и облачные вычисления • От запроса к согласованному результату" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="32" y="88" width="1350" height="38" as="geometry"/></mxCell><mxCell id="n3" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EFF5FC;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="40" y="150" width="430" height="260" as="geometry"/></mxCell><mxCell id="n4" parent="1" vertex="1" value="01 Назначение и ACID" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="52" y="158" width="406" height="45" as="geometry"/></mxCell><mxCell id="n5" parent="1" vertex="1" value="Монитор организует обработку запросов&#10;и согласованное завершение операций.&#10;&#10;A — всё или ничего&#10;C — соблюдение ограничений&#10;I — изоляция параллельной работы&#10;D — сохранность фиксации" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="52" y="205" width="406" height="192" as="geometry"/></mxCell><mxCell id="n6" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0F7F4;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="505" y="150" width="430" height="260" as="geometry"/></mxCell><mxCell id="n7" parent="1" vertex="1" value="02 Участники X/Open DTP" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="517" y="158" width="406" height="45" as="geometry"/></mxCell><mxCell id="n8" parent="1" vertex="1" value="AP — прикладная программа&#10;Выполняет бизнес-операции&#10;&#10;TM — менеджер транзакций&#10;Координирует общий результат&#10;&#10;RM — менеджер ресурсов&#10;Хранит данные и локальное состояние" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="517" y="205" width="406" height="192" as="geometry"/></mxCell><mxCell id="n9" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F7F3EC;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="970" y="150" width="430" height="260" as="geometry"/></mxCell><mxCell id="n10" parent="1" vertex="1" value="03 Двухфазная фиксация" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="982" y="158" width="406" height="45" as="geometry"/></mxCell><mxCell id="n11" parent="1" vertex="1" value="1. PREPARE — опрос участников&#10;Участники сохраняют готовность&#10;&#10;2. COMMIT или ROLLBACK&#10;Координатор сообщает общее решение&#10;&#10;COMMIT принимается после готовности&#10;всех необходимых участников" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="982" y="205" width="406" height="192" as="geometry"/></mxCell><mxCell id="n12" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FAF0EF;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="40" y="440" width="430" height="260" as="geometry"/></mxCell><mxCell id="n13" parent="1" vertex="1" value="04 Отказ и восстановление" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="52" y="448" width="406" height="45" as="geometry"/></mxCell><mxCell id="n14" parent="1" vertex="1" value="Тайм-аут не доказывает откат.&#10;&#10;После PREPARE участник может ждать&#10;решение, удерживая блокировки.&#10;&#10;Решение COMMIT записывается устойчиво.&#10;После сбоя оно повторно доставляется.&#10;&#10;Классический 2PC может блокироваться." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="52" y="495" width="406" height="192" as="geometry"/></mxCell><mxCell id="n15" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EFF5FC;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="505" y="440" width="430" height="260" as="geometry"/></mxCell><mxCell id="n16" parent="1" vertex="1" value="05 Перевод 1 000 рублей" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="517" y="448" width="406" height="45" as="geometry"/></mxCell><mxCell id="n17" parent="1" vertex="1" value="Два ресурса с общей координацией&#10;&#10;До: А = 10 000 Б = 5 000&#10;COMMIT: А = 9 000 Б = 6 000&#10;Откат: А = 10 000 Б = 5 000&#10;&#10;Итоговая сумма — 15 000 рублей.&#10;Повтор запроса проверяется по ID.&#10;Пример условный, без комиссии." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="517" y="495" width="406" height="192" as="geometry"/></mxCell><mxCell id="n18" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0F7F4;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="970" y="440" width="430" height="260" as="geometry"/></mxCell><mxCell id="n19" parent="1" vertex="1" value="06 Реализации и облако" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="982" y="448" width="406" height="45" as="geometry"/></mxCell><mxCell id="n20" parent="1" vertex="1" value="Oracle Tuxedo — платформа и ATMI&#10;IBM CICS — задачи и единицы работы&#10;MSDTC — координатор транзакций&#10;&#10;Сага — локальные шаги и компенсации&#10;Outbox — запись данных и события&#10;в одной локальной транзакции&#10;&#10;Выбор зависит от требуемых гарантий." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="982" y="495" width="406" height="192" as="geometry"/></mxCell><mxCell id="n21" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F6F9;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="40" y="735" width="895" height="170" as="geometry"/></mxCell><mxCell id="n22" parent="1" vertex="1" value="07 Вопросы для самопроверки" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="55" y="742" width="860" height="42" as="geometry"/></mxCell><mxCell id="n23" parent="1" vertex="1" value="Чем монитор отличается от средства наблюдения?&#10;Почему PREPARE ещё не означает успешную фиксацию?&#10;Что делать, если ответ клиенту потерян после COMMIT?&#10;Когда вместо общей ACID-транзакции уместна сага?" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="55" y="790" width="860" height="100" as="geometry"/></mxCell><mxCell id="n24" parent="1" vertex="1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F7F3EC;strokeColor=#D4DCE5;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="970" y="735" width="430" height="170" as="geometry"/></mxCell><mxCell id="n25" parent="1" vertex="1" value="08 Главная связь" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="980" y="742" width="410" height="42" as="geometry"/></mxCell><mxCell id="n26" parent="1" vertex="1" value="Прикладные правила + TM + RM&#10;→ согласованная операция&#10;&#10;2PC обеспечивает атомарный итог,&#10;а изоляцию проверяют отдельно." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172C45;fontFamily=Arial;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="980" y="785" width="410" height="115" as="geometry"/></mxCell><mxCell id="n27" parent="1" vertex="1" value="Источники: IBM CICS; Oracle Tuxedo; Microsoft MS-DTCO; PostgreSQL; Gray и Lamport; AWS. Подробные ссылки — в отчёте." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#52657C;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacing=12;spacingTop=0;spacingBottom=0;"><mxGeometry x="35" y="930" width="1370" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>